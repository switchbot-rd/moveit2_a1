<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>onero_a1_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files and ros2_control configuration for the Onero A1 arm.
    Provides the topic bridge that connects joint_state_topic_hardware_interface
    to onero-sdk.
  </description>
  <maintainer email="dev@onerobot.com">Onero Robotics</maintainer>
  <license>Apache-2.0</license>

  <url type="repository">https://github.com/onerobotics/onero_a1_ros2</url>
  <url type="bugtracker">https://github.com/onerobotics/onero_a1_ros2/issues</url>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- onero-sdk[dynamics] is installed from PyPI by setup_env.sh.
       The requirements and ROS compatibility constraints are maintained under tools/.
       No unregistered rosdep key is declared here. -->

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>moveit_py</exec_depend>
  <exec_depend>onero_a1_kinematics</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>onero_a1_description</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
