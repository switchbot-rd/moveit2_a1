<?xml version="1.0"?>
<package format="3">
  <name>onero_a1_common</name>
  <version>0.1.0</version>
  <description>Shared MoveIt ROS clients for Onero A1 applications and tools.</description>
  <maintainer email="dev@onerobot.com">Onero Robotics</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
