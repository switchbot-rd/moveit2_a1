<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>onero_a1_moveit_config</name>
  <version>0.1.0</version>
  <description>
    MoveIt 2 configuration for the Onero A1 7-DOF robot arm.
    SRDF is generated from the SDK model with adjacent-link collision exclusions
    (see tools/sync_srdf_from_sdk.py).
  </description>
  <maintainer email="dev@onerobot.com">Onero Robotics</maintainer>
  <license>Apache-2.0</license>

  <url type="repository">https://github.com/onerobotics/onero_a1_ros2</url>
  <url type="bugtracker">https://github.com/onerobotics/onero_a1_ros2/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- launch 文件里 import 的包 -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_ros_planning_interface</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_planners_chomp</exec_depend>
  <exec_depend>moveit_planners_stomp</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>onero_a1_description</exec_depend>
  <exec_depend>onero_a1_bringup</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>moveit_servo</exec_depend>
  <exec_depend>onero_a1_servo</exec_depend>
  <exec_depend>onero_a1_kinematics</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
